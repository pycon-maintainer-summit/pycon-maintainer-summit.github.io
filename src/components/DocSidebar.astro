---
import { getCollection } from "astro:content";

const { current } = Astro.props as { current?: string };

const allDocs = await getCollection("docs");
const sorted = allDocs.sort((a, b) => a.data.order - b.data.order);

const grouped = sorted.reduce<Record<string, typeof sorted>>((acc, doc) => {
  const group = doc.data.audience;
  acc[group] ??= [];
  acc[group].push(doc);
  return acc;
}, {});

const groupLabels: Record<string, string> = {
  attendee: "For Attendees",
  speaker: "For Speakers",
  organizer: "For Organizers",
  general: "General",
};
---

<aside class="doc-sidebar">
  <nav aria-label="Documentation">
    {Object.entries(grouped).map(([group, docs]) => (
      <section>
        <h4>{groupLabels[group] ?? group}</h4>
        <ul>
          {docs.map((doc) => (
            <li>
              <a
                href={`/docs/${doc.id}`}
                aria-current={current === doc.id ? "page" : undefined}
              >
                {doc.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>

<style>
  .doc-sidebar {
    position: sticky;
    top: var(--space-6);
    align-self: start;
  }
  .doc-sidebar section { margin-bottom: var(--space-6); }
  .doc-sidebar h4 {
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .doc-sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .doc-sidebar a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    border-left: 3px solid transparent;
  }
  .doc-sidebar a:hover { background: var(--color-bg-muted); }
  .doc-sidebar a[aria-current="page"] {
    background: var(--color-bg-muted);
    color: var(--color-brand-dark);
    border-left-color: var(--color-brand);
    font-weight: 600;
  }
</style>