---
import { banner } from "../data/site";

if (!banner.show) return;
---

<aside class="site-banner" role="status" aria-label="Site notice">
  <div class="container banner-inner">
    <span class="banner-tag" aria-hidden="true">⚠️</span>
    <p>
      <strong>{banner.title}</strong>
      <span class="banner-message"> — {banner.message}</span>
    </p>
  </div>
</aside>

<style>
  .site-banner {
    background: repeating-linear-gradient(
      135deg,
      var(--color-accent) 0,
      var(--color-accent) 16px,
      var(--color-accent-dark) 16px,
      var(--color-accent-dark) 32px
    );
    color: var(--color-brand-dark);
    border-bottom: 3px solid var(--color-brand-dark);
    padding: var(--space-3) 0;
  }
  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    text-align: center;
  }
  .banner-inner p {
    margin: 0;
    font-size: var(--font-size-base);
  }
  .banner-inner strong {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-brand-dark);
    color: var(--color-accent);
    padding: 2px 10px;
    border-radius: var(--radius-sm);
    font-weight: 800;
  }
  .banner-message {
    font-weight: 600;
  }
  .banner-tag {
    font-size: var(--font-size-lg);
  }
</style>
