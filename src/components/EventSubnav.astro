---
import { getCollection } from 'astro:content';

interface Props {
  eventId: string;
  current: 'overview' | 'speakers' | 'topics';
}

const { eventId, current } = Astro.props;
const speakers = await getCollection('speakers', (s) => s.data.event.id === eventId);
const topics = await getCollection('topics', (t) => t.data.event.id === eventId);

const items: { key: Props['current']; label: string; count?: number }[] = [
  { key: 'overview', label: 'Overview' },
  { key: 'speakers', label: 'Speakers', count: speakers.length },
  { key: 'topics', label: 'Topics', count: topics.length },
];
---

<nav class="g-container subnav" aria-label="Event sections">
  {items.map((item) => (
    <a
      href={`/events/${eventId}/${item.key === 'overview' ? '' : item.key + '/'}`}
      aria-current={current === item.key ? 'page' : undefined}
    >
      {item.label}{item.count !== undefined && ` (${item.count})`}
    </a>
  ))}
</nav>

<style>
  .subnav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    border-bottom: 1px solid var(--ink-200);
    padding-top: var(--space-4);
    padding-bottom: 0;
  }
  .subnav a {
    text-decoration: none;
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .subnav a:hover { color: var(--color-primary); }
  .subnav a[aria-current='page'] {
    color: var(--text-strong);
    border-bottom-color: var(--color-primary);
  }
</style>