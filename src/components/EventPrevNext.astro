---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props { current: CollectionEntry<'events'> }
const { current } = Astro.props;

// Sort chronologically — older first, newer last.
const all = (await getCollection('events')).sort((a, b) => a.data.year - b.data.year);
const idx = all.findIndex((e) => e.id === current.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
---

{(prev || next) && (
  <nav class="prevnext" aria-label="Other events">
    {prev ? (
      <a href={`/events/${prev.id}/`} class="g-card prevnext__card">
        <span class="prevnext__dir"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Previous event</span>
        <span class="prevnext__title">{prev.data.title}</span>
        <span class="prevnext__meta">{prev.data.year}{prev.data.city && ` · ${prev.data.city}`}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
    {next ? (
      <a href={`/events/${next.id}/`} class="g-card prevnext__card prevnext__card--next">
        <span class="prevnext__dir">Next event <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        <span class="prevnext__title">{next.data.title}</span>
        <span class="prevnext__meta">{next.data.year}{next.data.city && ` · ${next.data.city}`}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
  </nav>
)}

<style>
  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  @media (max-width: 40rem) {
    .prevnext { grid-template-columns: 1fr; }
  }
  .prevnext__card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-3);
    text-decoration: none;
  }
  .prevnext__card--next { text-align: right; }
  .prevnext__dir {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .prevnext__title { font-weight: var(--weight-semibold); color: var(--text-strong); }
  .prevnext__meta { font-size: var(--text-sm); color: var(--text-muted); }
</style>