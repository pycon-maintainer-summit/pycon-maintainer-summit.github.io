---
import BaseLayout from "./BaseLayout.astro";
import DocSidebar from "../components/DocSidebar.astro";
import PageHero from "../components/PageHero.astro";

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const { title, description, current } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} eyebrow="Documentation" description={description} />
  <div class="container doc-grid">
    <DocSidebar current={current} />
    <article class="doc-body">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .doc-grid {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: var(--space-12);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }
  @media (max-width: 48rem) {
    .doc-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  .doc-body :global(h2) { margin-top: var(--space-8); }
  .doc-body :global(h3) { margin-top: var(--space-6); }
  .doc-body :global(ul),
  .doc-body :global(ol) { padding-left: var(--space-6); }
</style>