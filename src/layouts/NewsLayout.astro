---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { formatAuthors } from "../lib/authors";

interface Props {
  title: string;
  date: Date;
  author: string[];
  summary?: string;
  tags?: string[];
}

const { title, date, author, summary, tags = [] } = Astro.props;
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  publishedTime={date}
  author={author}
  tags={tags}
>
  <PageHero title={title} eyebrow="News & Announcements">
    <p class="byline">
      <time datetime={date.toISOString()}>{formatted}</time>
      <span> · {formatAuthors(author)}</span>
    </p>
  </PageHero>
  <article class="container container-narrow news-article">
    {summary && <p class="lede">{summary}</p>}
    <slot />
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (<li><span class="tag">{tag}</span></li>))}
      </ul>
    )}
    <p class="back"><a href="/news">← Back to all news</a></p>
  </article>
</BaseLayout>

<style>
  .byline {
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    margin: var(--space-3) 0 0;
  }
  .news-article { padding: var(--space-12) 0; }
  .lede {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: var(--space-8) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .back { margin-top: var(--space-8); }
</style>