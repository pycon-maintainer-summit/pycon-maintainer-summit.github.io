---
import "../styles/theme.css";
import Banner from "../components/Banner.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** "website" for most pages, "article" for news posts. */
  ogType?: "website" | "article";
  /** Path or absolute URL. Falls back to site.defaultOgImage. */
  ogImage?: string;
  /** Article-specific (only used when ogType === "article"). */
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string | string[];
  tags?: string[];
}

const {
  title,
  description = site.description,
  ogType = "website",
  ogImage,
  publishedTime,
  modifiedTime,
  author,
  tags = [],
} = Astro.props;

const fullTitle = title ? `${title} · ${site.shortName}` : site.name;
const baseUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, baseUrl).toString();

const resolvedImage = ogImage ?? site.defaultOgImage;
const ogImageUrl = resolvedImage
  ? new URL(resolvedImage, baseUrl).toString()
  : undefined;

const rssHref = new URL("/rss.xml", baseUrl).toString();
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.rssTitle}
      href={rssHref}
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale.replace("-", "_")} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    {/* Article-specific OG */}
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {ogType === "article" && author && (Array.isArray(author) ? author : [author]).map((name) => (
      <meta property="article:author" content={name} />
    ))}
    {ogType === "article" && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    {/* Twitter / X */}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Banner />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: var(--space-2);
        background: var(--color-brand-dark);
        color: #fff;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
        z-index: 100;
      }
      .skip-link:focus { left: var(--space-2); }
    </style>
  </body>
</html>
