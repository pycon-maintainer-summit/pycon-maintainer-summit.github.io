---
/** Base layout: head, brand token overrides, header, footer, shared JS.
 *  SEO/OG handling is extended from the upstream theme: canonical URLs and
 *  absolute OG/Twitter image URLs resolve against the live request origin in
 *  dev and the configured `site` in builds (the deploy URL on Netlify
 *  previews, the github.io / custom domain in production). */
import '../styles/tokens/fonts.css';
import '../styles/tokens/colors.css';
import '../styles/tokens/typography.css';
import '../styles/tokens/spacing.css';
import '../styles/tokens/elevation.css';
import '../styles/base.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DemoBar from '../components/DemoBar.astro';
import { SITE, BRAND, STRINGS } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** "website" for most pages, "article" for news posts. */
  ogType?: 'website' | 'article';
  /** Article-specific (only used when ogType === "article"). */
  publishedTime?: Date;
  modifiedTime?: Date;
  authorNames?: string[];
  tags?: string[];
}
const {
  title,
  description,
  image,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  authorNames = [],
  tags = [],
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.shortName ?? SITE.title}` : `${SITE.title}, ${SITE.tagline}`;
const desc = description ?? SITE.description;

const baseUrl = import.meta.env.DEV
  ? new URL(Astro.url.origin)
  : (Astro.site ?? Astro.url);
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const resolvedImage = image ?? SITE.ogImage;
const ogImageUrl = resolvedImage ? new URL(resolvedImage, baseUrl).toString() : undefined;
const rssHref = new URL('/rss.xml', baseUrl).toString();

/* Brand overrides: mirrors the Hugo theme's brand-vars.html partial. */
const vars: string[] = [];
const b = BRAND;
if (b.primary) {
  vars.push(`--color-primary:${b.primary}`, `--raspberry-500:${b.primary}`);
  vars.push(`--raspberry-50:color-mix(in srgb, ${b.primary} 7%, #fff)`);
  vars.push(`--raspberry-300:color-mix(in srgb, ${b.primary} 55%, #fff)`);
}
if (b.primaryHover) vars.push(`--color-primary-hover:${b.primaryHover}`);
if (b.primaryActive) vars.push(`--color-primary-active:${b.primaryActive}`, `--raspberry-700:${b.primaryActive}`, `--text-link:${b.primaryActive}`);
if (b.secondary) vars.push(`--color-secondary:${b.secondary}`);
if (b.accent) vars.push(`--color-accent:${b.accent}`, `--indigo-500:${b.accent}`);
if (b.ink) vars.push(`--ink-800:${b.ink}`, `--text-strong:${b.ink}`);
if (b.surfacePink) vars.push(`--surface-pink:${b.surfacePink}`);
if (b.surfacePinkSoft) vars.push(`--surface-pink-soft:${b.surfacePinkSoft}`);
if (b.surfaceInk) vars.push(`--surface-ink:${b.surfaceInk}`);
if (b.fontSans) vars.push(`--font-sans:${b.fontSans}`);
if (b.fontDisplay) vars.push(`--font-display:${b.fontDisplay}`);
if (b.radiusCard) vars.push(`--radius-xl:${b.radiusCard}`);
if (b.containerMax) vars.push(`--container-max:${b.containerMax}`);
/* html:root outranks the token files' :root so the override wins regardless of
   where Astro injects the bundled stylesheet in <head>. */
const brandCss = `html:root{${vars.join(';')}}`;
---

<!DOCTYPE html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    {/* Article-specific OG */}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {ogType === 'article' && authorNames.map((name) => (
      <meta property="article:author" content={name} />
    ))}
    {ogType === 'article' && tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    {/* Twitter / X */}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={desc} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" href={SITE.favicon ?? SITE.logo} />
    <link rel="alternate" type="application/rss+xml" title={SITE.rssTitle ?? SITE.title} href={rssHref} />
    <link rel="stylesheet" href={SITE.fontAwesome} referrerpolicy="no-referrer" />
    <style is:inline id="popular-brand" set:html={brandCss}></style>
  </head>
  <body data-copy-label={STRINGS.copyCode} data-checklist-done={STRINGS.checklistDone}>
    <a class="g-skip" href="#main">{STRINGS.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DemoBar />
    <script src="/scripts/nav.js" is:inline defer></script>
    <script src="/scripts/checklist.js" is:inline defer></script>
    <script src="/scripts/toc.js" is:inline defer></script>
    <script src="/scripts/blog-filter.js" is:inline defer></script>
    <script src="/scripts/copy-code.js" is:inline defer></script>
  </body>
</html>