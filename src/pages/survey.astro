---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Attendee Survey"
  description="Tell us what you thought of the Maintainers Summit — your feedback shapes next year's program."
>
  <PageHero
    title="Attendee Survey"
    eyebrow="Tell us what you thought"
    description="A few minutes of your time helps us shape next year's program. All questions are optional."
  />

  <section class="section">
    <div class="container container-narrow">
      <form
        name="attendee-survey"
        method="POST"
        action="/survey/thanks"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        class="survey-form"
      >
        {/* Required for Netlify to map the submission to this form */}
        <input type="hidden" name="form-name" value="attendee-survey" />

        {/* Honeypot — real users won't see this; bots fill everything */}
        <p class="hp" hidden aria-hidden="true">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <fieldset>
          <legend>Did you attend?</legend>
          <label><input type="radio" name="attendance" value="in-person" /> Yes, in person</label>
          <label><input type="radio" name="attendance" value="remote" /> Yes, remotely</label>
          <label><input type="radio" name="attendance" value="planning" /> Plan to next year</label>
          <label><input type="radio" name="attendance" value="no" /> No</label>
        </fieldset>

        <fieldset>
          <legend>Overall, how would you rate the summit?</legend>
          <div class="rating">
            <label><input type="radio" name="rating" value="5" /> 5 — Excellent</label>
            <label><input type="radio" name="rating" value="4" /> 4</label>
            <label><input type="radio" name="rating" value="3" /> 3 — OK</label>
            <label><input type="radio" name="rating" value="2" /> 2</label>
            <label><input type="radio" name="rating" value="1" /> 1 — Poor</label>
          </div>
        </fieldset>

        <p class="field">
          <label for="most-valuable">Which session(s) did you find most valuable?</label>
          <textarea id="most-valuable" name="most-valuable" rows="3" placeholder="Talk titles, speaker names, or BoF topics."></textarea>
        </p>

        <p class="field">
          <label for="future-topics">What topics would you like to see at future summits?</label>
          <textarea id="future-topics" name="future-topics" rows="3"></textarea>
        </p>

        <p class="field">
          <label for="improvements">What could we improve?</label>
          <textarea id="improvements" name="improvements" rows="3" placeholder="Format, venue, schedule, accessibility, anything."></textarea>
        </p>

        <fieldset>
          <legend>Would you recommend the summit to a colleague?</legend>
          <label><input type="radio" name="would-recommend" value="yes" /> Yes</label>
          <label><input type="radio" name="would-recommend" value="maybe" /> Maybe</label>
          <label><input type="radio" name="would-recommend" value="no" /> No</label>
        </fieldset>

        <fieldset>
          <legend>Are you a maintainer of an open source project?</legend>
          <label><input type="radio" name="maintainer" value="yes" /> Yes</label>
          <label><input type="radio" name="maintainer" value="sometimes" /> Sometimes / contributor</label>
          <label><input type="radio" name="maintainer" value="no" /> No, but I'm interested</label>
        </fieldset>

        <p class="field">
          <label for="how-heard">How did you hear about the summit?</label>
          <select id="how-heard" name="how-heard">
            <option value="">— Choose one —</option>
            <option value="pycon-schedule">PyCon US schedule</option>
            <option value="colleague">A colleague told me</option>
            <option value="social-media">Social media</option>
            <option value="newsletter">Newsletter</option>
            <option value="search">Search engine</option>
            <option value="other">Other</option>
          </select>
        </p>

        <p class="field">
          <label for="email">Email <span class="muted">(optional, for follow-up only)</span></label>
          <input id="email" type="email" name="email" autocomplete="email" />
        </p>

        <p class="field">
          <label for="other-feedback">Anything else you'd like to share?</label>
          <textarea id="other-feedback" name="other-feedback" rows="4"></textarea>
        </p>

        <p class="actions">
          <button type="submit" class="button button-accent">Submit survey</button>
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .survey-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  fieldset {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  legend {
    font-weight: 600;
    color: var(--color-brand-dark);
    padding: 0 var(--space-2);
  }
  fieldset label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
  }
  fieldset label:hover { color: var(--color-brand); }

  .rating { display: flex; flex-direction: column; gap: var(--space-2); }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }
  .field > label {
    font-weight: 600;
    color: var(--color-brand-dark);
  }

  textarea, input[type="email"], select {
    font: inherit;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    width: 100%;
  }
  textarea { resize: vertical; }
  textarea:focus, input:focus, select:focus {
    outline: 2px solid var(--color-brand);
    outline-offset: 1px;
    border-color: var(--color-brand);
  }

  .actions { margin: 0; }
  .actions .button { cursor: pointer; border: 0; font: inherit; }

  .hp { position: absolute; left: -10000px; }
</style>
