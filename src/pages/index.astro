---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import EventCard from '../components/EventCard.astro';
import OrganizerCard from '../components/OrganizerCard.astro';
import { HOME, STRINGS, CURRENT_YEAR } from '../config';

/* Feature the upcoming summit when one is announced; otherwise the most
   recent past edition (status-based, not date-based as in the upstream theme). */
const events = await getCollection('events');
const upcoming = events.filter((e) => e.data.status === 'upcoming').sort((a, b) => b.data.year - a.data.year);
const latestPast = events.filter((e) => e.data.status === 'past').sort((a, b) => b.data.year - a.data.year);
const featured = upcoming[0] ?? latestPast[0];

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const organizers = (await getCollection('organizers'))
  .filter((o) => o.data.years.includes(CURRENT_YEAR))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const h = HOME;
---

<BaseLayout>
  {h.hero && (
    <section class="g-hero">
      <div class="g-container g-hero__grid">
        <div class="g-hero__content">
          {h.hero.eyebrow && <span class="g-eyebrow">{h.hero.eyebrow}</span>}
          <h1>{h.hero.title}</h1>
          {h.hero.lead && <p class="g-hero__lead">{h.hero.lead}</p>}
          {h.hero.ctas && (
            <div class="g-row">
              {h.hero.ctas.map((c) => (
                <a class={`g-btn g-btn--lg g-btn--${c.variant ?? 'primary'}`} href={c.url}>
                  {'icon' in c && c.icon && <i class={c.icon} aria-hidden="true"></i>}{c.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {h.stats && (
    <section class="g-bg-ink">
      <div class="g-container g-stats">
        {h.stats.map((s) => (
          <div class="g-stat"><div class="g-stat__n">{s.n}</div><div class="g-stat__l">{s.l}</div></div>
        ))}
      </div>
    </section>
  )}

  {h.features && (
    <section class="g-bg-white g-section">
      <div class="g-container">
        {h.featuresHead && (
          <div class="g-section-head">
            {h.featuresHead.eyebrow && <span class="g-eyebrow">{h.featuresHead.eyebrow}</span>}
            <h2>{h.featuresHead.title}</h2>
            {h.featuresHead.lead && <p class="g-lead">{h.featuresHead.lead}</p>}
          </div>
        )}
        <div class="g-grid-3" style="margin-top:var(--space-5)">
          {h.features.map((f) => (
            <div class="g-card"><div class="g-card__body">
              <span class="g-medallion"><i class={f.icon} aria-hidden="true"></i></span>
              <h3 class="g-card__title">{f.title}</h3>
              <p class="g-card__text">{f.body}</p>
            </div></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {featured && (
    <section class="g-bg-pink-soft g-section">
      <div class="g-container">
        <div class="g-row" style="justify-content:space-between;align-items:flex-end">
          <div class="g-section-head">
            <span class="g-eyebrow">{featured.data.status === 'upcoming' ? STRINGS.nextMeetup : STRINGS.lookingBack}</span>
            <h2>{featured.data.status === 'upcoming' ? STRINGS.nextMeetup : `The ${featured.data.year} summit`}</h2>
          </div>
          <a class="g-btn g-btn--ghost" href="/events/">{STRINGS.allEvents} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div style="margin-top:var(--space-4);max-width:34rem">
          <EventCard event={featured} />
        </div>
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="g-bg-white g-section">
      <div class="g-container">
        <div class="g-row" style="justify-content:space-between;align-items:flex-end">
          <div class="g-section-head">
            <span class="g-eyebrow">{STRINGS.fromTheBlog}</span>
            <h2>{STRINGS.latestFromCommunity}</h2>
          </div>
          <a class="g-btn g-btn--ghost" href="/news/">{STRINGS.readTheBlog} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="g-grid-3" style="margin-top:var(--space-4)">
          {posts.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  {organizers.length > 0 && (
    <section class="g-bg-tertiary g-section">
      <div class="g-container">
        <div class="g-section-head g-section-head--center">
          <span class="g-eyebrow">The team</span>
          <h2>{CURRENT_YEAR} organizers</h2>
          <p class="g-lead">The volunteers who make the summit happen.</p>
        </div>
        <div class="g-grid-3" style="margin-top:var(--space-5)">
          {organizers.map((o) => <OrganizerCard organizer={o} />)}
        </div>
        <div class="g-row" style="justify-content:center;margin-top:var(--space-4)">
          <a class="g-btn g-btn--outline" href="/organizers/">All organizers</a>
        </div>
      </div>
    </section>
  )}

  {h.getInvolved && (
    <section class="g-bg-pink g-section">
      <div class="g-container" style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:1rem">
        <span class="g-eyebrow">{h.getInvolved.eyebrow ?? 'Community'}</span>
        <h2 style="margin:0;max-width:40rem">{h.getInvolved.title}</h2>
        {h.getInvolved.lead && <p style="margin:0;color:var(--ink-700);max-width:38rem">{h.getInvolved.lead}</p>}
        <div class="g-row" style="justify-content:center">
          {h.getInvolved.ctas.map((c) => (
            <a class={`g-btn g-btn--${c.variant ?? 'primary'}`} href={c.url}>{c.label}</a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>