---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { contact } from "../data/site";
---

<BaseLayout title="Contact" description="Ways to reach the Maintainers Summit team.">
  <PageHero
    title="Contact us"
    eyebrow="Contact"
    description="The fastest way to reach us is by email."
  />

  <section class="section">
    <div class="container container-narrow">
      <h2>Email</h2>
      <p>
        For program, sponsorship, or media inquiries:
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>

      <h2>GitHub</h2>
      <p>
        Site source and issues:
        <a href={contact.github} rel="noopener">{contact.github}</a>
      </p>

      <h2>Code of Conduct concerns</h2>
      <p>
        Reports related to the Code of Conduct should follow the
        <a href="/docs/code-of-conduct">CoC reporting process</a>.
      </p>
    </div>
  </section>
</BaseLayout>