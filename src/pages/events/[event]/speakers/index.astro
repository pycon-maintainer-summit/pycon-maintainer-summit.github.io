---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from 'astro-theme-popular/components/PageHero.astro';
import EventSubnav from '../../../../components/EventSubnav.astro';
import SpeakerCard from '../../../../components/SpeakerCard.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { event: event.id }, props: { event } }));
}

const { event } = Astro.props;
const speakers = (await getCollection('speakers', (s) => s.data.event.id === event.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title={`Speakers · ${event.data.title}`} description={`Speakers at ${event.data.title}`}>
  <PageHero
    eyebrow={event.data.title}
    title="Speakers"
    lead={`The lineup for ${event.data.date} in ${event.data.location}.`}
  />

  <EventSubnav eventId={event.id} current="speakers" />

  <section class="g-bg-white g-section--sm">
    <div class="g-container">
      {speakers.length === 0 ? (
        <p class="g-lead">Speakers will be announced closer to the event.</p>
      ) : (
        <div class="g-grid-3">
          {speakers.map((speaker) => <SpeakerCard speaker={speaker} eventId={event.id} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>