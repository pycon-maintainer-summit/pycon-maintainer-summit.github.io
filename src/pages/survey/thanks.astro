---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout
  title="Thanks for your feedback"
  description="Thanks for taking the Maintainers Summit attendee survey."
>
  <PageHero
    title="Thanks for your feedback!"
    eyebrow="Survey received"
    description="We read every response. Your input directly shapes next year's summit."
  />

  <section class="section">
    <div class="container container-narrow">
      <p>
        If you left your email, we may follow up with a question or two —
        we won't add you to any list. Otherwise, you can also reach us at
        <a href="mailto:maintainers-pyconus@googlegroups.com">maintainers-pyconus@googlegroups.com</a>
        any time.
      </p>
      <p>
        <a href="/" class="button">Back to home</a>
      </p>
    </div>
  </section>
</BaseLayout>
