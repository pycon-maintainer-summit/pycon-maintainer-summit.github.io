---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import NewsPreview from "../../components/NewsPreview.astro";

const all = (await getCollection("news"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="News" description="News and announcements from the Maintainers Summit team.">
  <PageHero
    title="News & Announcements"
    eyebrow="Blog"
    description="Updates from the summit team — CFPs, programs, and more."
  >
    <p class="rss-link">
      <a href="/rss.xml" rel="alternate" type="application/rss+xml">Subscribe via RSS →</a>
    </p>
  </PageHero>

  <section class="section">
    <div class="container">
      {all.length === 0 ? (
        <p class="muted">No posts yet — check back soon.</p>
      ) : (
        <div class="grid grid-2">
          {all.map((post) => <NewsPreview post={post} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .rss-link { margin: var(--space-4) 0 0; }
  .rss-link a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .rss-link a:hover { text-decoration: underline; }
</style>